{
  "name": "dnd5r-firebase-google-isolated-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src/model.test.ts src/spell-reference.test.tsx",
    "test:rules": "vitest run rules-tests --no-file-parallelism",
    "test:e2e": "start-server-and-test \"vite --host 127.0.0.1 --port 5188\" http://127.0.0.1:5188 \"node e2e-emulator.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "playwright": "^1.64.1",
    "start-server-and-test": "^3.0.13",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.10"
  }
}
