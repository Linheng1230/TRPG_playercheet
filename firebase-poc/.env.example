# Firebase Console > Project settings > Your apps > Web App public config.
# These values are Web SDK identifiers, NOT service account keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Only local http://127.0.0.1 can use the emulator flag.
VITE_FIREBASE_USE_EMULATORS=false
